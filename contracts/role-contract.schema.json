{
  "": "https://findu.local/contracts/role-contract.schema.json",
  "title": "Agent Role Contract",
  "description": "agent 角色只描述行为，不承载权限；权限一律由 core/rbac 决定。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "system_prompt"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "description": {
      "type": "string"
    },
    "system_prompt": {
      "type": "string",
      "minLength": 1
    },
    "icon": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "type": "string"
        },
        "temperature": {
          "type": "number"
        },
        "max_tokens": {
          "type": "integer"
        }
      }
    },
    "memory": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_turns": {
          "type": "integer"
        },
        "token_budget": {
          "type": "integer"
        }
      }
    }
  }
}
